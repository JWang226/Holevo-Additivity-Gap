Nonadditivity.HaarPrescribedDimension.exists_prescribed_channel_with_lower_bound {K n : ℕ} (hK : 2 ≤ K)
  (hn : Nonadditivity.Quantitative.n₀ K ≤ n) :
  ∃ T,
    Fintype.card T.Input = 2 * Nonadditivity.StructuredHaarConsequences.localDimension K n ^ n * K ^ (2 * n) ∧
      Fintype.card T.Output = K ^ n ∧
        0 < T.chi ∧
          2 * ↑n / ↑K ≤ T.chi ∧
            T.chi ≤
                ↑n * Nonadditivity.Scalar.aK ↑K +
                  2 * Nonadditivity.Scalar.log2 (Nonadditivity.StructuredHaarConsequences.kappa n) ∧
              ↑n * Nonadditivity.Scalar.log2 ↑K / ↑K ≤ T.chiTwo ∧
                ↑n * Nonadditivity.Scalar.deltaK ↑K -
                    4 * Nonadditivity.Scalar.log2 (Nonadditivity.StructuredHaarConsequences.kappa n) ≤
                  T.gap
'Nonadditivity.HaarPrescribedDimension.exists_prescribed_channel_with_lower_bound' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Nonadditivity.Operational.operationalCapacity_eq_regularizedHolevoSupremum.{u_1, u_2, u_3} {ι : Type u_1} {ο : Type u_2}
  {κ : Type u_3} [Fintype ι] [DecidableEq ι] [Nonempty ι] [Fintype ο] [DecidableEq ο] [Nonempty ο] [Fintype κ]
  (T : Nonadditivity.Channels.KrausChannel ι ο κ) :
  Nonadditivity.Operational.operationalCapacity T =
    sSup (Set.range (Nonadditivity.RegularizedHolevo.normalizedPowerHolevo T))
'Nonadditivity.Operational.operationalCapacity_eq_regularizedHolevoSupremum' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Nonadditivity.OperationalConsequences.exists_small_chi_large_capacity_gain_and_two_use_ratio {ε : ℝ} (hε : 0 < ε)
  (A R : ℝ) : ∃ T, 0 < T.chi ∧ T.chi ≤ ε ∧ A ≤ T.classicalCapacity - T.chi ∧ R ≤ T.twoUseRatio
