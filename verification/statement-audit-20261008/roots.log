Nonadditivity.WeylPowers.positiveTensorPower_weylExtension_holevoBits.{u_1, u_2} {ι : Type u_1} {κ : Type u_2}
  [Fintype ι] [DecidableEq ι] [Nonempty ι] [Fintype κ] {d : ℕ} [NeZero d]
  (T : Nonadditivity.Channels.KrausChannel ι (ZMod d) κ) (n : ℕ) :
  (Nonadditivity.RegularizedHolevo.positiveTensorPower T.weylExtension n).holevoBits =
    ↑(n + 1) * Nonadditivity.Scalar.log2 ↑d -
      (Nonadditivity.RegularizedHolevo.positiveTensorPower T n).minimumEntropy / Real.log 2
'Nonadditivity.WeylPowers.positiveTensorPower_weylExtension_holevoBits' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Nonadditivity.PrescribedCost.growingFamily_chi_input_cost_bounds :
  ∀ᶠ (K : ℕ) in Filter.atTop,
    Nonadditivity.PrescribedCost.inputLogScale / 2 ≤
        (Nonadditivity.PrescribedCost.growingFamily K).chi *
          √(Nonadditivity.Scalar.log2 (Nonadditivity.PrescribedCost.inputQubits K)) ∧
      (Nonadditivity.PrescribedCost.growingFamily K).chi *
          √(Nonadditivity.Scalar.log2 (Nonadditivity.PrescribedCost.inputQubits K)) ≤
        (9 / Real.log 2 + 1) * (2 * Nonadditivity.PrescribedCost.inputLogScale)
'Nonadditivity.PrescribedCost.growingFamily_chi_input_cost_bounds' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Nonadditivity.PrescribedCost.growingFamily_two_use_input_cost_lower :
  ∀ᶠ (K : ℕ) in Filter.atTop,
    1 / (8 * Real.log 2 * Nonadditivity.PrescribedCost.inputLogScale) ≤
        (Nonadditivity.PrescribedCost.growingFamily K).chiTwo / 2 /
          √(Nonadditivity.Scalar.log2 (Nonadditivity.PrescribedCost.inputQubits K)) ∧
      1 / (8 * Real.log 2 * Nonadditivity.PrescribedCost.inputLogScale) ≤
        (Nonadditivity.PrescribedCost.growingFamily K).classicalCapacity /
          √(Nonadditivity.Scalar.log2 (Nonadditivity.PrescribedCost.inputQubits K))
'Nonadditivity.PrescribedCost.growingFamily_two_use_input_cost_lower' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Nonadditivity.DeterministicConsequences.actual_small_large {ε R : ℝ} (hε : 0 < ε) :
  ∃ T, 0 < T.chi ∧ T.chi ≤ ε ∧ R ≤ T.chiTwo / 2
'Nonadditivity.DeterministicConsequences.actual_small_large' depends on axioms: [propext, Classical.choice, Quot.sound]
